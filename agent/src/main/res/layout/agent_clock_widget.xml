<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agentClockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1.0">

        <TextClock
            android:id="@+id/agentClockDate"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.22"
            android:format12Hour="M月d日(EEE)"
            android:format24Hour="M月d日(EEE)"
            android:gravity="top|center_horizontal"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp" />

        <TextClock
            android:id="@+id/agentClockTime"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.56"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:textColor="#FFF4F0F0"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/agentClockWifiInfo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.22"
            android:fontFamily="monospace"
            android:gravity="bottom|center_horizontal"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:lineSpacingMultiplier="1.0"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:singleLine="true"
            android:text="@string/agent_clock_widget_wifi_placeholder"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
