{
  "value_sets": {
    "family":["ipv4","ipv6","auto"], "record":["A","AAAA","ALL"],
    "security":["auto","wpa2","wpa3","transition"], "band":["all","2.4ghz","5ghz","6ghz","60ghz"],
    "mac-randomization":["auto","none","persistent","non-persistent"],
    "require-ip":["true","false"], "require-validated":["true","false"], "forget-after-each":["true","false"]
  },
  "commands": [
    {"path":"show version", "effect":"local", "description":"Show local application version"},
    {"path":"show cli", "effect":"local", "description":"Show safe current Shell session state"},
    {"path":"show network", "effect":"read", "description":"Inspect all Android Networks without scanning Wi-Fi"},
    {"path":"show network default", "effect":"read", "description":"Inspect the captured Android platform default Network"},
    {"path":"show network id", "positionals":["network-id"], "effect":"read", "description":"Inspect exactly one Connectivity Network ID"},
    {"path":"show permissions", "effect":"read", "description":"Show permissions and Device Owner status"},
    {"path":"show wifi status", "effect":"read", "description":"Show a quick connection, radio, IP and MLO summary without ADB supplements"},
    {"path":"show wifi status full", "effect":"read", "description":"Show all passive Wi-Fi diagnostics including safe raw dumps"},
    {"path":"show wifi status connection", "effect":"read", "description":"Show all connection and radio observations"},
    {"path":"show wifi status ip", "values":["ssid","bssid","network-id"], "effect":"read", "description":"Show all selected physical Wi-Fi IP observations"},
    {"path":"show wifi status capabilities", "effect":"read", "description":"Show all device Wi-Fi capabilities"},
    {"path":"show wifi status eht", "values":["ssid","bssid"], "effect":"read", "description":"Show focused EHT/MLO connection, AP and device evidence"},
    {"path":"show wifi scan", "switches":["brief","mlo"], "values":["ssid","bssid","band"], "effect":"read", "description":"Show complete cached AP observations, optionally restricted"},
    {"path":"request wifi connect", "positionals":["ssid"], "values":["passphrase","security","bssid","band","mac-randomization","timeout"], "pc_values":["passphrase-env"], "effect":"mutation", "description":"Connect immediately using explicit or session credentials; one target"},
    {"path":"request wifi disconnect", "effect":"mutation", "description":"Disconnect immediately; one target and Device Owner required"},
    {"path":"request wifi reconnect", "values":["timeout"], "effect":"mutation", "description":"Reconnect immediately; one target and Device Owner required"},
    {"path":"request wifi forget ssid", "positionals":["ssid"], "effect":"mutation", "description":"Forget exact SSID matches without numeric ID interpretation"},
    {"path":"request wifi forget config-id", "positionals":["config-id"], "effect":"mutation", "description":"Forget exactly one saved Wi-Fi configuration ID"},
    {"path":"request wifi cycle", "positionals":["ssid"], "required":["passphrase"], "values":["passphrase","security","bssid","band","mac-randomization","timeout","count","ping","http","forget-after-each","pause"], "effect":"mutation", "description":"Run bounded connection cycles with explicit credentials and optional probes"},
    {"path":"request wifi scan", "switches":["brief","mlo"], "values":["ssid","bssid","band","timeout"], "effect":"read", "description":"Request one active scan and return the AP evidence"},
    {"path":"request wifi scan eht", "values":["ssid","bssid","band","timeout"], "effect":"read", "description":"Request one active scan and return full EHT/MLO evidence"},
    {"path":"request ping", "positionals":["host"], "values":["count","size","family","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Send ICMP probes on the selected physical Wi-Fi Network"},
    {"path":"request traceroute", "positionals":["host"], "values":["max-hops","via","size","family","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Trace a route using typed hop observations"},
    {"path":"request path-mtu", "positionals":["host"], "values":["min-mtu","max-mtu","family","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Probe path MTU in IP-packet bytes"},
    {"path":"request global-ip", "values":["family","timeout","ssid","bssid","network-id"], "enums":{"family":["ipv4","ipv6","all"]}, "effect":"probe", "description":"Query global IP addresses using the existing service"},
    {"path":"request dns", "positionals":["name"], "values":["record","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Resolve names on the selected Network"},
    {"path":"request http", "positionals":["url"], "values":["expected-status","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Send an HTTP request"},
    {"path":"request download", "positionals":["url"], "values":["timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Download on the selected Network"},
    {"path":"test wifi", "values":["ssid","bssid","security","band","require-ip","require-validated","timeout"], "effect":"read", "description":"Evaluate typed Wi-Fi expectations immediately or with a bounded wait"},
    {"path":"test link", "required":["ssid"], "values":["ssid","family","bssid"], "enums":{"family":["ipv4","ipv6","all"]}, "effect":"read", "description":"Evaluate physical Wi-Fi provisioning without probes; one target"},
    {"path":"test lab", "required":["ssid","family","gateway","dns","resolver","http","expected-status","timeout"], "values":["ssid","family","gateway","dns","resolver","http","expected-status","timeout"], "enums":{"family":["ipv4","ipv6"]}, "effect":"probe", "description":"Run explicitly configured and authorized lab probes; one target"},
    {"path":"monitor wifi", "values":["duration","interval"], "effect":"read", "description":"Observe a finite Wi-Fi event window"},
    {"path":"help", "positionals":["topic"], "effect":"local", "description":"Show contextual help for any command hierarchy"},
    {"path":"set cli default-passphrase", "positionals":["passphrase"], "effect":"session", "description":"Set a credential in memory for this Shell session only"},
    {"path":"clear cli default-passphrase", "effect":"session", "description":"Clear the session credential"},
    {"path":"show test profiles", "effect":"local", "description":"List tests, prerequisites and traffic cost without running them"},
    {"path":"show test last", "effect":"local", "description":"Show all safe evidence for the last historical test attempt"}
  ]
}
