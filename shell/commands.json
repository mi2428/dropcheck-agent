{
  "aliases": {"p":"ping", "tr":"traceroute", "pm":"path-mtu", "gip":"global-ip", "h":"help", "?":"help"},
  "value_sets": {
    "family":["ipv4","ipv6","auto"], "record":["A","AAAA","ALL"],
    "security":["auto","wpa2","wpa3","transition"], "band":["all","2.4ghz","5ghz","6ghz","60ghz"],
    "mac-randomization":["auto","none","persistent","non-persistent"],
    "require-ip":["true","false"], "require-validated":["true","false"], "forget-after-each":["true","false"]
  },
  "commands": [
    {"path":"show version", "effect":"local", "description":"Show application version"},
    {"path":"show networks", "effect":"read", "description":"List Android Networks without scanning Wi-Fi"},
    {"path":"show network", "positionals":["target"], "effect":"read", "description":"Inspect the default Network or an explicit Network ID"},
    {"path":"show permissions", "effect":"read", "description":"Show permissions and Device Owner status"},
    {"path":"show wifi status", "switches":["detail"], "effect":"read", "description":"Show the current Wi-Fi connection"},
    {"path":"show wifi diagnostics", "switches":["detail"], "effect":"read", "description":"Collect independently observed Wi-Fi and Network snapshots"},
    {"path":"show wifi capabilities", "switches":["detail"], "effect":"read", "description":"Show device Wi-Fi capabilities"},
    {"path":"show wifi scan", "switches":["fresh","brief","mlo"], "values":["band","timeout"], "effect":"read", "description":"Show cached APs, or request a fresh scan"},
    {"path":"show wifi scan detail", "positionals":["target"], "values":["band"], "effect":"read", "description":"Inspect APs matching an SSID or BSSID"},
    {"path":"show wifi eht", "switches":["detail","fresh"], "values":["ssid","bssid","timeout"], "effect":"read", "description":"Show EHT/MLO evidence and its provenance"},
    {"path":"show ip status", "switches":["detail"], "values":["ssid","bssid","network-id"], "effect":"read", "description":"Show the selected physical Wi-Fi Network"},
    {"path":"wifi connect", "positionals":["ssid"], "required":["passphrase"], "values":["passphrase","security","bssid","band","mac-randomization","timeout"], "pc_values":["passphrase-env"], "effect":"mutation", "description":"Connect immediately; requires Device Owner"},
    {"path":"wifi disconnect", "effect":"mutation", "description":"Disconnect immediately; requires Device Owner"},
    {"path":"wifi forget", "positionals":["target"], "effect":"mutation", "description":"Forget a saved network immediately; requires Device Owner"},
    {"path":"wifi wait connected", "values":["ssid","bssid","security","band","require-ip","require-validated","timeout"], "effect":"read", "description":"Wait for a matching Wi-Fi observation"},
    {"path":"wifi assert", "values":["ssid","bssid","security","band","require-ip","require-validated","timeout"], "effect":"read", "description":"Assert typed Wi-Fi observations"},
    {"path":"wifi monitor", "values":["duration","interval"], "effect":"read", "description":"Observe bounded Wi-Fi events"},
    {"path":"wifi reconnect", "values":["timeout"], "effect":"mutation", "description":"Reconnect immediately; requires Device Owner"},
    {"path":"wifi cycle", "positionals":["ssid"], "required":["passphrase"], "values":["passphrase","security","bssid","band","mac-randomization","timeout","count","ping","http","forget-after-each","pause"], "effect":"mutation", "description":"Run bounded connection cycles and optional probes"},
    {"path":"ping", "positionals":["host"], "values":["count","size","family","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Send ICMP probes on the selected Network"},
    {"path":"traceroute", "positionals":["host"], "values":["max-hops","via","size","family","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Trace a route using typed hop observations"},
    {"path":"path-mtu", "positionals":["host"], "values":["min-mtu","max-mtu","family","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Probe the path MTU"},
    {"path":"global-ip", "values":["family","timeout","ssid","bssid","network-id"], "enums":{"family":["ipv4","ipv6","all"]}, "effect":"probe", "description":"Query global IP addresses"},
    {"path":"dns", "positionals":["name"], "values":["record","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Resolve names on the selected Network"},
    {"path":"http", "positionals":["url"], "values":["expected-status","timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Send an HTTP request"},
    {"path":"download", "positionals":["url"], "values":["timeout","ssid","bssid","network-id"], "effect":"probe", "description":"Download on the selected Network"},
    {"path":"help", "positionals":["topic"], "effect":"local", "description":"Show help without executing device operations"},
    {"path":"set default passphrase", "positionals":["passphrase"], "effect":"session", "description":"Set a credential in memory for this Shell session only"},
    {"path":"clear default passphrase", "effect":"session", "description":"Clear the session credential"},
    {"path":"use", "positionals":["ssid"], "values":["passphrase"], "effect":"mutation", "description":"Connect using an explicit or session credential"},
    {"path":"check", "positionals":["name"], "required":["ssid"], "values":["ssid","family","bssid","gateway","dns","resolver","http","expected-status","timeout"], "enums":{"family":["ipv4","ipv6","all"]}, "effect":"probe", "description":"Run link observations or an explicitly configured lab check"},
    {"path":"show checks", "effect":"local", "description":"List available check profiles without running them"},
    {"path":"show check last", "switches":["detail"], "effect":"local", "description":"Show the last check report"}
  ]
}
